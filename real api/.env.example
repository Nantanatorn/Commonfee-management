# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า
DB_USER=
DB_PASSWORD=
DB_NAME=Commonfee
DB_PORT=1433
EMAIL_USER=
EMAIL_PASS=
# ยาวอย่างน้อย 16 ตัวอักษร
JWT_SECRET=
# เบอร์ PromptPay (10 หลัก) ที่ใช้สร้าง QR รับเงิน
PROMPTPAY_PHONE=
# ออกบิลประจำเดือนอัตโนมัติ (ค่าเริ่มต้น: ปิด) -- เปิดแล้วระบบจะส่งอีเมลแจ้งบิลให้ลูกบ้านทุกคน
AUTO_BILL=false
# วันที่ของเดือนที่เริ่มออกบิล (1-28)
BILL_DAY=1
